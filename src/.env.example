# chave da OpenAI (obrigatória) — pegue em platform.openai.com/api-keys
OPENAI_API_KEY=

# modelo principal e modelo barato para tarefas simples
ANA_MODEL=gpt-4.1-mini
ANA_MODEL_BARATO=gpt-4.1-nano

# pasta onde a Ana pode ler e escrever (projetos)
ANA_AREA=./projetos

# permitir que a Ana rode comandos no terminal (sim/nao)
ANA_PERMITIR_COMANDO=sim

# ---- WhatsApp (Evolution API) ----
EVOLUTION_URL=http://localhost:8080
EVOLUTION_KEY=
EVOLUTION_INSTANCIA=ana
ZAP_PORTA=8787
# números autorizados a conversar com a Ana (só dígitos, separados por vírgula). Vazio = todos
ZAP_PERMITIDOS=

# ---- painel de custo ----
PAINEL_PORTA=8788
# preço por 1 MILHÃO de tokens, copiado da sua conta OpenAI (deixe 0 se não quiser valor em reais)
PRECO_ENTRADA=0
PRECO_SAIDA=0

[Unit]
Description=Ana ANATECH MG - atendimento no WhatsApp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ana
WorkingDirectory=/opt/ana
EnvironmentFile=/opt/ana/.env
ExecStart=/usr/bin/node /opt/ana/src/whatsapp.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/ana/whatsapp.log
StandardError=append:/var/log/ana/whatsapp.log
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
